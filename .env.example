# 复制本文件为 .env 或直接设置环境变量（.env 不入库）
# 本项目当前不会自动读取 .env，需要你在启动前用 `$env:XXX` 设置，或用 Node --env-file 方式加载。

# LangGraph 决策器自动使用智谱 GLM-4-Flash 免费档（只需填 Key）
ZHIPUAI_API_KEY=your-zhipu-key

# 也可以显式指定其他 OpenAI 兼容端点（优先级高于智谱自动）
RAG_GRAPH_LLM_BASE_URL=
RAG_GRAPH_LLM_MODEL=
RAG_GRAPH_LLM_API_KEY=

# 是否启用 LangGraph Agentic RAG：1 启用 / 0 或 false 关闭
RAG_GRAPH_ENABLED=1

# LangGraph 决策模式：llm = 用 LangChain/ChatOpenAI 决策；rule = 规则决策（不调 LLM）
RAG_GRAPH_DECISION=llm
